# Nivisa API configuration.
#
# docker-compose.yml already sets everything needed for local work, so this
# file matters when you run the API outside Docker, or when you are preparing
# a real deployment.
#
# GOING TO PRODUCTION is the four *_PROVIDER lines below plus the credentials
# each one needs. Nothing else in this file, and no code, has to change.

# ---- Identity ---------------------------------------------------------------
# local      every stand-in provider allowed, fixed OTP code, demo seed.
# staging    real database and storage, stand-ins still permitted. This is
#            what an internal deployment runs while the client has not yet
#            supplied an SMS or payment account.
# production the guards bite: the API refuses to start on a default
#            SECRET_KEY, PAYMENT_PROVIDER=mock, or SMS_PROVIDER=console.
APP_ENV=local                      # local | staging | production
API_PREFIX=/api/v1

# ---- Datastores -------------------------------------------------------------
# Supabase: use the POOLER host, not the direct one - the direct host is
# IPv6-only on new projects and most shared hosts only have IPv4. TLS is a
# query parameter here, not sslmode: asyncpg does not read libpq's spelling.
#   postgresql+asyncpg://postgres.PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://nivisa:nivisa@localhost:5432/nivisa
# Declared, and currently unused by any code path. OTP challenges and their
# rate limits live in Postgres. Nothing to provision.
REDIS_URL=redis://localhost:6379/0
SQL_ECHO=false

# Per PROCESS, and cPanel's Passenger runs several. Shared hosting against a
# pooled database wants these small - 3 and 5 is plenty for internal use.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

# ---- Auth -------------------------------------------------------------------
# The app refuses to start in production while this is the default value.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ADMIN_TOKEN_TTL_MINUTES=720
CUSTOMER_TOKEN_TTL_MINUTES=43200

# ---- Front ends -------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
STOREFRONT_URL=http://localhost:3001
# Where a BROWSER reaches this API (payment redirects, emailed links).
PUBLIC_API_URL=http://localhost:8000

# ---- Store ------------------------------------------------------------------
STORE_NAME=Nivisa
STORE_EMAIL=hello@nivisa.in
STORE_PHONE=+91 80 0000 0000
CURRENCY=INR

# =============================================================================
# Swappable providers. Each has a free local implementation and a paid one.
# =============================================================================

# ---- Payments ---------------------------------------------------------------
# mock     - a local checkout screen, no gateway, no money. Refused in production.
# phonepe  - the real hosted checkout.
PAYMENT_PROVIDER=mock
PHONEPE_MERCHANT_ID=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=SANDBOX

# ---- File storage -----------------------------------------------------------
# local - files on disk, served by the API at MEDIA_URL_PREFIX.
# s3    - any S3-compatible bucket: AWS, Cloudflare R2, DigitalOcean Spaces.
# bunny - Bunny Edge Storage over Bunny's own API, with a pull zone in front.
#         Bunny's S3 endpoint is still in public preview, which is why this is
#         a provider of its own rather than a set of S3_ values.
STORAGE_PROVIDER=local
MEDIA_ROOT=/data/media
MEDIA_URL_PREFIX=/media
MAX_UPLOAD_MB=10
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# Bunny. The access key is the STORAGE ZONE PASSWORD (Storage > your zone >
# FTP & API Access), not the account API key - the account key cannot write
# files and returns 401 on every upload.
#
# BUNNY_STORAGE_HOST must match the region the zone was created in:
#   storage.bunnycdn.com     Falkenstein (default)
#   sg.storage.bunnycdn.com  Singapore   <- closest to India
#   ny. la. syd. uk. se. br. jh.         the rest
#
# BUNNY_PUBLIC_BASE_URL is the PULL ZONE - https://yourzone.b-cdn.net, or a
# CNAME onto it. Point this at the storage host instead and the site works,
# uncached, from origin, with your storage password in the request path.
BUNNY_STORAGE_ZONE=
BUNNY_ACCESS_KEY=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_PUBLIC_BASE_URL=

# ---- Email ------------------------------------------------------------------
# console - written to the log.
# smtp    - a real SMTP server. Mailpit locally, a relay in production.
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
MAIL_FROM=orders@nivisa.in
MAIL_FROM_NAME=Nivisa

# ---- SMS (login OTP) --------------------------------------------------------
# console - the code goes to the log, and in APP_ENV=local it is always
#           OTP_CONSOLE_CODE so no log-reading is needed to sign in.
#           The fixed code requires BOTH console AND local; neither alone.
# msg91   - real SMS.
SMS_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_CONSOLE_CODE=123456
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# ---- Bootstrap super admin --------------------------------------------------
# Read once, by scripts/seed.py, when no account with this email exists.
# Changing it afterwards does nothing - use the Staff screen.
SUPER_ADMIN_EMAIL=superadmin@nivisa.in
SUPER_ADMIN_PASSWORD=Nivisa@2026
SUPER_ADMIN_NAME=Super Admin
