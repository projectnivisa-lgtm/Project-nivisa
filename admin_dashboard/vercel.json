{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://staging.thirdeyegfx.in/nivisa/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://staging.thirdeyegfx.in/nivisa/media/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
