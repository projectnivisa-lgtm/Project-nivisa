# Where the dashboard's API calls are sent.
#
# The dev server proxies /api and /media to this target, so the browser only
# ever makes same-origin requests and CORS never enters into it. Unset, it is
# http://127.0.0.1:8000 — the local stack. Docker Compose sets it to the api
# service. Point it at a deployment to work against one:
#
#     VITE_API_PROXY_TARGET=https://staging.thirdeyegfx.in/nivisa
#
# A path prefix in the target is kept, so /nivisa above is correct.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Only for a BUILT dashboard served from an origin that cannot proxy /api.
# The API's root, no trailing slash, no /api/v1 — the client appends that.
# Requires this dashboard's origin in the API's CORS_ORIGINS.
# VITE_API_URL=https://staging.thirdeyegfx.in/nivisa
