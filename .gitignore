# The three applications each carried their own git repo before this one was
# made. Their histories were moved here rather than deleted; nothing in it
# belongs in this repository. To recover one:
#     mv .subrepo-git-backup/apis.git apis/.git
.subrepo-git-backup/

# ---- Secrets ---------------------------------------------------------------
# Real credentials. The sub-directories ignore their own .env files too, but
# this repository is public, so the rule is restated here where it is read.
.env
.env.*
!.env.example

# A deployment bundle of apis/, built by zipping the application root - which
# means it contains a copy of apis/.env, live Supabase, SECRET_KEY and Bunny
# credentials and all. .gitignore does not look inside an archive, so the .env
# rule above does not cover it and the whole file has to be excluded. Rebuild
# it when deploying; never commit one.
*.zip

# ---- Dependencies and build output ------------------------------------------
node_modules/
.next/
dist/
build/
*.tsbuildinfo

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# ---- Client source material -------------------------------------------------
# The photographs the client handed over, 20MB of them. Bunny is the store of
# record - tools/import_client_assets.py uploaded all 139 and every URL is in
# tools/client-assets-manifest.json, so the import is reproducible without
# them. Kept out of a public repository, and out of a history that could not
# drop them again afterwards. The originals stay on the machine that ran the
# import.
assets/

# ---- Uploads ----------------------------------------------------------------
# Only present with STORAGE_PROVIDER=local; on staging these live on Bunny.
apis/media/

# ---- Editors and OS ---------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
