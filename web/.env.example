# The API's root, with no trailing slash. /api/v1 is appended by the app, so
# a deployment served under a path prefix keeps the prefix here:
#   local stack   http://localhost:8000
#   staging       https://staging.thirdeyegfx.in/nivisa
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Only needed when the Next.js server and the browser reach the API at
# different addresses, as in Docker. Never NEXT_PUBLIC_.
# INTERNAL_API_BASE_URL=http://api:8000

# Public origin of the storefront. Used for canonicals and structured data.
NEXT_PUBLIC_SITE_URL=https://nivisa.example

# Renders sample furniture content plus a visible "demo content" banner.
# Never set this in production.
NEXT_PUBLIC_DEMO_CONTENT=false
